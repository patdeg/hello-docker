# Copy this file to ".env" (which is gitignored) and fill in real values.
# Never commit the real ".env" file.

# Postgres password for the "nakama" database user. Pick something you
# wouldn't mind rotating - it's injected at container start (see
# docker-compose.yml), never baked into either image.
POSTGRES_PASSWORD=

# Nakama's "socket server key" - game clients must send this string to
# authenticate API requests. Think of it as the server's half of a shared
# secret, not a per-player password. Change it from any example value
# before running this anywhere but your own laptop.
NAKAMA_SERVER_KEY=

# Login for the admin Console (http://127.0.0.1:7351 by default - see
# README.md for why that stays on 127.0.0.1 even after you open the game
# ports to strangers).
NAKAMA_CONSOLE_USER=
NAKAMA_CONSOLE_PASSWORD=
