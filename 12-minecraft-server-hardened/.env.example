# Copy this file to ".env" (which is gitignored) and fill in real values.
# Never commit the real ".env" file.

# Optional: enables RCON (remote console) with this password, injected at
# container start by entrypoint.sh - never baked into the image. Leave
# blank/unset to keep RCON disabled entirely (the more hardened default).
RCON_PASSWORD=

# How much memory to give the JVM. Leave room for the host OS itself -
# don't set this to your machine's full RAM.
JAVA_MEM=2048M
